# Optional backend connectivity for live processing.
# If these are not set, the app uses local simulation mode for Lab and local fallback for region insights.

# FITS upload + job status websocket/http backend (without protocol also works, e.g. 127.0.0.1:5000)
VITE_APP_BACKEND_URL=127.0.0.1:5000

# Region insight HTTP backend
VITE_APP_REGION_BACKEND=127.0.0.1:5000
